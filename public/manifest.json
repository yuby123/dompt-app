{
  "name": "FadDompet — Dompet & Keuangan Pribadi",
  "short_name": "FadDompet",
  "description": "Offline-first personal finance tracker & Ekstraksi Otomatis Bukti Transfer / SS",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0F766E",
  "theme_color": "#0F766E",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/faddompet-lightmode.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/faddompet-darkmode.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/app_icon.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
