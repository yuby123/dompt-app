{
  "name": "Dompt. — Dompet & Keuangan Pribadi",
  "short_name": "Dompt.",
  "description": "Offline-first personal finance tracker. Kelola pemasukan, pengeluaran, dompet, dan anggaran pribadi.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#121316",
  "theme_color": "#D4F826",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/icons/dompt-logo.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "screenshot",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
