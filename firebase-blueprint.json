{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and credentials stored in Cloud Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "passwordHash": { "type": "string", "maxLength": 256 },
        "settingsJson": { "type": "string", "maxLength": 10000 },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "status": { "type": "string", "enum": ["pending", "active", "deactivated"] },
        "approvedAt": { "type": "string", "maxLength": 50 },
        "approvedBy": { "type": "string", "maxLength": 128 },
        "deactivatedAt": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "User feedback and bug reports submitted to Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "userName": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["bug", "feedback", "feature", "other"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "pageContext": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["open", "in_progress", "resolved", "closed"] },
        "adminReply": { "type": "string", "maxLength": 2000 },
        "repliedAt": { "type": "string", "maxLength": 50 },
        "repliedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "userEmail", "userName", "type", "priority", "title", "description", "status"]
    },
    "Wallet": {
      "title": "Wallet",
      "description": "User financial wallet or account",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "maxLength": 50 },
        "icon": { "type": "string", "maxLength": 50 },
        "color": { "type": "string", "maxLength": 50 },
        "initialBalance": { "type": "number" },
        "reservedAmount": { "type": "number" },
        "isDefault": { "type": "boolean" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "name", "type", "initialBalance"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income, expense, or transfer transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "walletId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["income", "expense", "transfer"] },
        "amount": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 100 },
        "budgetGroup": { "type": "string", "maxLength": 50 },
        "expenseNature": { "type": "string", "enum": ["variable", "fixed", "savings", "grocery", "non_daily"] },
        "date": { "type": "string", "maxLength": 30 },
        "note": { "type": "string", "maxLength": 500 },
        "transferWalletId": { "type": "string", "maxLength": 128 },
        "transferFee": { "type": "number" },
        "imageReceiptUrl": { "type": "string", "maxLength": 500 },
        "receiptImageUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "walletId", "type", "amount", "categoryId", "date"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Financial saving goal or emergency fund target",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "deadline": { "type": "string", "maxLength": 30 },
        "targetDate": { "type": "string", "maxLength": 30 },
        "emoji": { "type": "string", "maxLength": 20 },
        "color": { "type": "string", "maxLength": 50 },
        "walletId": { "type": "string", "maxLength": 128 },
        "isEmergencyFund": { "type": "boolean" },
        "monthlyTargetSaving": { "type": "number" },
        "isLocked": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "title", "targetAmount", "currentAmount"]
    },
    "BudgetConfig": {
      "title": "BudgetConfig",
      "description": "50/30/20 budget configuration, subcategories, assets, investments, and user preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "estimatedIncome": { "type": "number" },
        "needsPercent": { "type": "number" },
        "wantsPercent": { "type": "number" },
        "savingsPercent": { "type": "number" },
        "subcategoriesJson": { "type": "string", "maxLength": 20000 },
        "subscriptionsJson": { "type": "string", "maxLength": 20000 },
        "liquidAssetsJson": { "type": "string", "maxLength": 20000 },
        "fixedAssetsJson": { "type": "string", "maxLength": 20000 },
        "investmentsJson": { "type": "string", "maxLength": 20000 },
        "categoryBudgetsJson": { "type": "string", "maxLength": 20000 },
        "settingsJson": { "type": "string", "maxLength": 10000 },
        "deletedIdsJson": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "estimatedIncome"]
    },
    "Debt": {
      "title": "Debt",
      "description": "Payable debt or receivable loan record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "type": { "type": "string", "enum": ["payable", "receivable"] },
        "totalAmount": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 50 },
        "contactName": { "type": "string", "maxLength": 100 },
        "startDate": { "type": "string", "maxLength": 50 },
        "walletId": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 50 },
        "interestRate": { "type": "number" },
        "isInstallment": { "type": "boolean" },
        "tenorMonths": { "type": "number" },
        "monthlyInstallment": { "type": "number" },
        "dueDayOfMonth": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "paid"] },
        "note": { "type": "string", "maxLength": 500 },
        "paymentsJson": { "type": "string", "maxLength": 20000 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "name", "type", "totalAmount", "remainingAmount", "dueDate", "contactName", "status"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Recurring subscription or routine income/expense schedule",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "emoji": { "type": "string", "maxLength": 20 },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "amount": { "type": "number" },
        "frequency": { "type": "string", "enum": ["monthly", "yearly", "weekly"] },
        "billingDay": { "type": "number" },
        "walletId": { "type": "string", "maxLength": 128 },
        "categoryId": { "type": "string", "maxLength": 100 },
        "subcategoryId": { "type": "string", "maxLength": 128 },
        "budgetGroup": { "type": "string", "maxLength": 50 },
        "isActive": { "type": "boolean" },
        "lastRecordedPeriod": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "userId", "name", "type", "amount", "frequency", "billingDay", "walletId", "categoryId", "isActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/bugReports/{reportId}": {
      "schema": { "$ref": "#/entities/BugReport" },
      "description": "User feedback and bug reports collection"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/Wallet" },
      "description": "User wallets subcollection"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User transactions subcollection"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User saving goals subcollection"
    },
    "/users/{userId}/budgetConfig/{configId}": {
      "schema": { "$ref": "#/entities/BudgetConfig" },
      "description": "User budget configuration subcollection"
    },
    "/users/{userId}/debts/{debtId}": {
      "schema": { "$ref": "#/entities/Debt" },
      "description": "User debts and installments subcollection"
    },
    "/users/{userId}/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "User recurring subscriptions and routine bills subcollection"
    }
  }
}
