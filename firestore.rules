rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAccountId(userId) {
      return isValidId(userId) && userId.matches('^acct_[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return (isSignedIn() && request.auth.uid == userId) || isValidAccountId(userId);
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'passwordHash', 'settingsJson', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 256))
        && (!('settingsJson' in data) || (data.settingsJson is string && data.settingsJson.size() <= 10000));
    }

    function isValidWallet(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'initialBalance'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'icon', 'color', 'initialBalance', 'reservedAmount', 'isDefault', 'isVerified', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type is string && data.type.size() <= 50
        && data.initialBalance is number
        && (!('reservedAmount' in data) || data.reservedAmount is number)
        && (!('isDefault' in data) || data.isDefault is bool)
        && (!('isVerified' in data) || data.isVerified is bool);
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'walletId', 'type', 'amount', 'categoryId', 'date'])
        && data.keys().hasOnly(['id', 'userId', 'walletId', 'type', 'amount', 'categoryId', 'budgetGroup', 'expenseNature', 'date', 'note', 'tags', 'transferWalletId', 'transferFee', 'imageReceiptUrl', 'receiptImageUrl', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.walletId is string && data.walletId.size() <= 128
        && data.type in ['income', 'expense', 'transfer']
        && data.amount is number
        && data.categoryId is string && data.categoryId.size() <= 100
        && (!('budgetGroup' in data) || (data.budgetGroup is string && data.budgetGroup.size() <= 50))
        && (!('expenseNature' in data) || data.expenseNature in ['variable', 'fixed'])
        && data.date is string && data.date.size() <= 30
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('transferWalletId' in data) || (data.transferWalletId is string && data.transferWalletId.size() <= 128))
        && (!('transferFee' in data) || data.transferFee is number)
        && (!('imageReceiptUrl' in data) || (data.imageReceiptUrl is string && data.imageReceiptUrl.size() <= 500))
        && (!('receiptImageUrl' in data) || (data.receiptImageUrl is string && data.receiptImageUrl.size() <= 500));
    }

    function isValidGoal(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'targetAmount', 'currentAmount'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'name', 'targetAmount', 'currentAmount', 'deadline', 'targetDate', 'emoji', 'color', 'walletId', 'isEmergencyFund', 'monthlyTargetSaving', 'isLocked', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.targetAmount is number
        && data.currentAmount is number
        && (!('deadline' in data) || (data.deadline is string && data.deadline.size() <= 30))
        && (!('targetDate' in data) || (data.targetDate is string && data.targetDate.size() <= 30))
        && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 20))
        && (!('color' in data) || (data.color is string && data.color.size() <= 50))
        && (!('walletId' in data) || (data.walletId is string && data.walletId.size() <= 128))
        && (!('isEmergencyFund' in data) || data.isEmergencyFund is bool)
        && (!('monthlyTargetSaving' in data) || data.monthlyTargetSaving is number)
        && (!('isLocked' in data) || data.isLocked is bool);
    }

    function isValidDebt(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'totalAmount', 'remainingAmount', 'dueDate', 'contactName', 'status'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'type', 'totalAmount', 'remainingAmount', 'dueDate', 'contactName', 'startDate', 'walletId', 'category', 'interestRate', 'isInstallment', 'tenorMonths', 'monthlyInstallment', 'dueDayOfMonth', 'status', 'note', 'paymentsJson', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.type in ['payable', 'receivable']
        && data.totalAmount is number
        && data.remainingAmount is number
        && data.dueDate is string && data.dueDate.size() <= 50
        && data.contactName is string && data.contactName.size() <= 100
        && data.status in ['active', 'paid']
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 50))
        && (!('walletId' in data) || (data.walletId is string && data.walletId.size() <= 128))
        && (!('category' in data) || (data.category is string && data.category.size() <= 50))
        && (!('interestRate' in data) || data.interestRate is number)
        && (!('isInstallment' in data) || data.isInstallment is bool)
        && (!('tenorMonths' in data) || data.tenorMonths is number)
        && (!('monthlyInstallment' in data) || data.monthlyInstallment is number)
        && (!('dueDayOfMonth' in data) || data.dueDayOfMonth is number)
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('paymentsJson' in data) || (data.paymentsJson is string && data.paymentsJson.size() <= 20000));
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'type', 'amount', 'frequency', 'billingDay', 'walletId', 'categoryId', 'isActive'])
        && data.keys().hasOnly(['id', 'userId', 'name', 'emoji', 'type', 'amount', 'frequency', 'billingDay', 'walletId', 'categoryId', 'subcategoryId', 'budgetGroup', 'isActive', 'lastRecordedPeriod', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('emoji' in data) || (data.emoji is string && data.emoji.size() <= 20))
        && data.type in ['expense', 'income']
        && data.amount is number
        && data.frequency in ['monthly', 'yearly', 'weekly']
        && data.billingDay is number
        && data.walletId is string && data.walletId.size() <= 128
        && data.categoryId is string && data.categoryId.size() <= 100
        && (!('subcategoryId' in data) || (data.subcategoryId is string && data.subcategoryId.size() <= 128))
        && (!('budgetGroup' in data) || (data.budgetGroup is string && data.budgetGroup.size() <= 50))
        && data.isActive is bool
        && (!('lastRecordedPeriod' in data) || (data.lastRecordedPeriod is string && data.lastRecordedPeriod.size() <= 20));
    }

    function isValidBudgetConfig(data) {
      return data.keys().hasAll(['id', 'userId', 'estimatedIncome'])
        && data.keys().hasOnly(['id', 'userId', 'estimatedIncome', 'needsPercent', 'wantsPercent', 'savingsPercent', 'subcategoriesJson', 'subscriptionsJson', 'liquidAssetsJson', 'fixedAssetsJson', 'investmentsJson', 'categoryBudgetsJson', 'settingsJson', 'deletedIdsJson', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.estimatedIncome is number
        && (!('needsPercent' in data) || data.needsPercent is number)
        && (!('wantsPercent' in data) || data.wantsPercent is number)
        && (!('savingsPercent' in data) || data.savingsPercent is number)
        && (!('subcategoriesJson' in data) || (data.subcategoriesJson is string && data.subcategoriesJson.size() <= 20000))
        && (!('subscriptionsJson' in data) || (data.subscriptionsJson is string && data.subscriptionsJson.size() <= 20000))
        && (!('liquidAssetsJson' in data) || (data.liquidAssetsJson is string && data.liquidAssetsJson.size() <= 20000))
        && (!('fixedAssetsJson' in data) || (data.fixedAssetsJson is string && data.fixedAssetsJson.size() <= 20000))
        && (!('investmentsJson' in data) || (data.investmentsJson is string && data.investmentsJson.size() <= 20000))
        && (!('categoryBudgetsJson' in data) || (data.categoryBudgetsJson is string && data.categoryBudgetsJson.size() <= 20000))
        && (!('settingsJson' in data) || (data.settingsJson is string && data.settingsJson.size() <= 10000))
        && (!('deletedIdsJson' in data) || (data.deletedIdsJson is string && data.deletedIdsJson.size() <= 20000));
    }

    // User Resource Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // Wallets sub-collection
      match /wallets/{walletId} {
        allow get: if isOwner(userId) && isValidId(walletId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(walletId)
          && isValidWallet(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(walletId)
          && isValidWallet(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(walletId);
      }

      // Transactions sub-collection
      match /transactions/{transactionId} {
        allow get: if isOwner(userId) && isValidId(transactionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(transactionId)
          && isValidTransaction(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      // Goals sub-collection
      match /goals/{goalId} {
        allow get: if isOwner(userId) && isValidId(goalId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(goalId)
          && isValidGoal(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(goalId)
          && isValidGoal(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(goalId);
      }

      // Budget sub-collection
      match /budgetConfig/{configId} {
        allow get: if isOwner(userId) && isValidId(configId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(configId)
          && isValidBudgetConfig(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(configId)
          && isValidBudgetConfig(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(configId);
      }

      // Debts sub-collection
      match /debts/{debtId} {
        allow get: if isOwner(userId) && isValidId(debtId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(debtId)
          && isValidDebt(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(debtId)
          && isValidDebt(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(debtId);
      }

      // Subscriptions sub-collection
      match /subscriptions/{subscriptionId} {
        allow get: if isOwner(userId) && isValidId(subscriptionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(subscriptionId)
          && isValidSubscription(incoming())
          && incoming().userId == userId;
        allow update: if isOwner(userId)
          && isValidId(subscriptionId)
          && isValidSubscription(incoming())
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(subscriptionId);
      }
    }
  }
}
